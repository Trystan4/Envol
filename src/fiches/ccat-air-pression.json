    {
      "id": "ccat-air-pression-003",
      "question": "Qu'est-ce que le Delta P ?",
      "answers": [
        {
          "text": "La différence entre la pression à l'intérieur de l'avion et la pression à l'extérieur de l'avion",
          "correct": true
        },
        {
          "text": "La différence entre la pression au niveau de la mer et la pression à l'altitude de croisière de l'avion",
          "correct": false
        },
        {
          "text": "La différence entre la pression cabine au sol et la pression cabine rencontrée à 8 000 ft",
          "correct": false
        },
        {
          "text": "La différence entre la pression d'oxygène dans le sang et la pression d'oxygène dans la cabine",
          "correct": false
        }
      ],
      "page": 5,
      "excerpt": {
        "text": "Delta P : différence entre la pression à l'intérieur de l'avion et la pression à l'extérieur de l'avion."
      }
    },
    {
      "id": "ccat-air-pression-004",
      "question": "Qu'est-ce que l'altitude pression cabine ?",
      "answers": [
        {
          "text": "Une altitude fictive correspondant à la pression atmosphérique artificiellement maintenue à l'intérieur de la cabine en raison de la pressurisation",
          "correct": true
        },
        {
          "text": "Une altitude fictive correspondant à la pression atmosphérique extérieure, mesurée hors de la cabine pendant la croisière",
          "correct": false
        },
        {
          "text": "L'altitude réelle de l'avion, mesurée par rapport au niveau de la mer, qui correspond à son altitude de croisière",
          "correct": false
        },
        {
          "text": "La différence entre l'altitude réelle de l'avion et l'altitude à laquelle la pression de la cabine est maintenue par la pressurisation",
          "correct": false
        }
      ],
      "page": 5,
      "excerpt": {
        "text": "Altitude pression cabine : Altitude fictive correspondant à la pression atmosphérique artificiellement maintenue à l'intérieur de la cabine d'un aéronef en raison de la pressurisation et rencontrée à 8.000 ft."
      }
    },
    {
      "id": "ccat-air-pression-005",
      "question": "Qu'est-ce que le temps de conscience utile ?",
      "answers": [
        {
          "text": "La période entre le manque d'oxygène occasionné par la dépressurisation et l'altération des facultés physiques et mentales qui en découle",
          "correct": true
        },
        {
          "text": "La période entre le début de la dépressurisation et le retour de l'avion à une altitude où l'oxygène redevient suffisant",
          "correct": false
        },
        {
          "text": "La période entre la pose du masque à oxygène et la récupération complète des facultés physiques et mentales",
          "correct": false
        },
        {
          "text": "La période pendant laquelle la cabine reste pressurisée après une panne, avant que les masques à oxygène ne tombent",
          "correct": false
        }
      ],
      "page": 5,
      "excerpt": {
        "text": "Le temps de conscience utile (ou réserve de temps) est la période entre le manque d'oxygène occasionné par la dépressurisation et l'altération des facultés physiques et mentales qui en découle."
      }
    },
